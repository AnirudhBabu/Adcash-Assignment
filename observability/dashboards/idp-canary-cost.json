{
  "title": "Adcash IDP - Canary Health & Cost",
  "uid": "idp-canary-cost",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "title": "order-service Success Rate (canary gate: 99.5%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{app=\"order-service\", status!~\"5.*\"}[2m])) / sum(rate(http_requests_total{app=\"order-service\"}[2m]))",
          "legendFormat": "success rate"
        },
        { "expr": "0.995", "legendFormat": "canary gate" }
      ]
    },
    {
      "title": "order-service p99 Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{app=\"order-service\"}[2m])) by (le))",
          "legendFormat": "p99"
        },
        { "expr": "0.3", "legendFormat": "canary gate" }
      ]
    },
    {
      "title": "Canary Weight (traffic split)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "rollout_canary_weight{name=\"order-service\"}", "legendFormat": "canary weight %" }
      ]
    },
    {
      "title": "Namespace Cost (OpenCost, $/day)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(node_namespace_cost_dollars_per_day) by (namespace)", "legendFormat": "{{namespace}}" }
      ]
    }
  ]
}
